- content_for :breadcrumbs do
  = link_to _("Admin Tools"), admin_path
  &raquo;
  = _("Regenerate Flat Posts")

= form_with url: do_regenerate_posts_path, method: :post do |f|
  .form-table
    .editor-title= _("Regenerate Flatposts")
    %div
      .sub= f.label :before, _("Last Regenerated Before")
      %div{class: cycle('even', 'odd')}= f.datetime_field :before, value: params[:before] || Time.zone.now
    %div
      .sub= _("Force Regenerate?")
      .checkbox-field.padding-5{class: cycle('even', 'odd')}
        = f.check_box :force, checked: params[:force]
        = f.label :force, _("Include Flatposts Regenerated Since Post Last Tagged")
    .form-table-ender
      = f.submit _("Regenerate"), class: 'button', id: 'submit_button', data: { disable_with: _("Regenerating...") }
