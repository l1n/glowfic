- content_for :breadcrumbs do
  = link_to _("You"), user_path(current_user)
  &raquo;
  = link_to _("Your Continuities"), user_boards_path(current_user)
  &raquo;
  %b= _("Create New")

= form_for @board, url: continuities_path, method: :post do |f|
  .form-table
    .editor-title= _("Create Continuity")
    = render 'editor', f: f
