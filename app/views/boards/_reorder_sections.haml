-# locals: ( sections: )

- reset_cycle
#reorder-sections-table
  .content-header
    = content_for :reorder_title
    .loading.float-right.hidden= loading_tag # TODO duplicate id
    .saveerror.float-right.hidden
      -# TODO duplicate id
      = image_tag "icons/exclamation.png", title: _("Error"), class: 'vmid', alt: '!'
      = _("Error, please refresh")
    .saveconf.float-right.hidden
      = image_tag "icons/accept.png", title: _("Saved"), class: 'vmid', alt: ''
      = _("Saved")
  %ul.sortable.table-list
    - sections.each do |section|
      %li.padding-5.section-ordered{class: cycle('even', 'odd'), data: { id: section.id, order: section.section_order }}
        .section-ordered-handle
          = image_tag "icons/arrow_double.png", title: _("Reorder"), class: 'disabled-arrow', alt: '↕'
        = link_to section.name, section
        .float-right
          = image_tag "icons/arrow_up.png", class: "section-up disabled-arrow", alt: _("Move Up")
          = image_tag "icons/arrow_down.png", class: "section-down disabled-arrow", alt: _("Move Down")
          = link_to edit_polymorphic_path(section) do
            = image_tag "icons/pencil.png", alt: _("Edit")
          = link_to section, method: :delete, data: { confirm: _("Are you sure you want to delete this section?") } do
            = image_tag "icons/cross.png", alt: _("Delete")
    - if sections.empty?
      %li.centered.padding-10{class: cycle('even', 'odd')}= _("— No items yet —")
