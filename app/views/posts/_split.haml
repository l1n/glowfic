-# locals: ()

= form_with url: do_split_post_path, method: :post do |f|
  .form-table#post-splitter
    .editor-title= _("Split Post")
    %div
      .sub= f.label :reply_id, _("Reply Id")
      %div{class: cycle('even', 'odd')}= f.text_field :reply_id, value: params[:reply_id], placeholder: _("Id of reply for new top post")
    %div
      .sub= f.label :subject
      %div{class: cycle('even', 'odd')}= f.text_field :subject, value: params[:subject], placeholder: _("New Subject")
    .form-table-ender
      = submit_tag _("Split"), class: 'button', id: 'submit_button', data: { disable_with: _("Splitting...") }
      = submit_tag _("Preview"), class: 'button', id: 'preview_button', name: 'button_preview', data: { disable_with: _("Previewing...") }
