= render 'breadcrumbs', subtitle: _("Split Post"), post: @post

- split_post_link = link_to(@reply.post.subject, @reply.post)
= safe_format(_("Splitting %{post} at reply id # %{reply_id}. New Post:"), post: split_post_link, reply_id: params[:reply_id])

.content-header= params[:subject]
- @reply.id = nil
= render 'replies/single', reply: @reply, hide_footer: true

= render 'split'
