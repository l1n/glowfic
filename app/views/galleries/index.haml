- content_for :breadcrumbs do
  - if @user.id == current_user.try(:id)
    = link_to _("You"), user_path(current_user)
    &raquo;
    %b= _("Your Galleries")
  - else
    = user_link(@user)
    &raquo;
    %b= format(_("%{username}'s Galleries"), username: @user.username)

%table
  %thead
    %tr
      %th.gallery-table-title{colspan: 4}
        - if @user.id == current_user.try(:id)
          = _("Your Galleries")
          = link_to new_gallery_path, class: 'gallery-new' do
            .link-box.action-new= _("+ New Gallery")
        - else
          = @user.username + "'s Galleries"
    %tr
      %th.sub= _("Name")
      %th.sub.width-150.centered= _("# of Icons")
      %th.sub.width-70= _("Manage")
      %th.sub.width-70= _("Expand")
  %tbody
    %tr
      %td.odd.gallery-name= link_to _("[Galleryless]"), user_gallery_path(id: 0, user_id: @user.id)
      %td.width-150.centered.odd.gallery-icon-count= @user.icons.where(has_gallery: false).count
      %td.width-70.odd.gallery-buttons
        - if @user.id == current_user.try(:id)
          = link_to add_gallery_path(id: 0), title: _("Add Icons"), class: 'gallery-add' do
            = image_tag "icons/add.png", alt: _("Add Icons")
      %td.centered.width-70.odd
        .gallery-box.vmid{id: "minmax-0", style: 'display: inline-block;', data: { id: 0 }}
          .view-button{style: 'padding: 5px 7px;'}
            = image_tag "icons/bullet_arrow_down.png", class: 'vmid down-arrow', alt: _("Show")
            = image_tag "icons/bullet_arrow_up.png", class: 'vmid hidden up-arrow', alt: _("Hide")
    %tr
      %td.padding-5.hidden.odd{id: "icons-0", colspan: 4}
        = form_tag delete_multiple_icons_path, method: :delete do
          .gallery{style: 'padding: 0px;'}
          - if @user.id == current_user.try(:id)
            .clear.centered.icons-remove
              = submit_tag _("x Delete selected icons permanently"), data: { confirm: _("Are you sure? These icons will be gone from the site!") }
    = render partial: 'galleries/expandable', collection: @galleries.with_icon_count.with_gallery_groups, as: :gallery

  - if @galleries.methods.include?(:total_pages) && @galleries.total_pages > 1
    %tfoot
      %tr
        %td{colspan: 4}= render 'posts/paginator', paginated: @galleries, no_per: true
