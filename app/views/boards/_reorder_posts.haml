-# locals: ( unsectioned_posts:, id: :id )

- reset_cycle
#reorder-posts-table
  .content-header
    = _("Organize Unsectioned Posts")
    .loading.float-right.hidden
      = image_tag 'icons/loading.gif', title: _("Loading..."), class: 'vmid', alt: '...', style: 'width: 16px; height: 16px;'
    .saveerror.float-right.hidden
      = image_tag "icons/exclamation.png", title: _("Error"), class: 'vmid', alt: '!'
      = _("Error, please refresh")
    .saveconf.float-right.hidden
      = image_tag "icons/accept.png", title: _("Saved"), class: 'vmid', alt: ''
      = _("Saved")
  %ul.sortable.table-list
    - unsectioned_posts.each do |post|
      %li.section-ordered{class: cycle('even', 'odd'), data: { id: post.send(id), order: post.section_order }}
        .section-ordered-handle
          = image_tag "icons/arrow_double.png", title: _("Reorder"), class: 'disabled-arrow', alt: '↕'
        = link_to post.subject, post_path(post)
        .float-right
          = image_tag "icons/arrow_up.png", class: "section-up disabled-arrow", alt: _("Move Up")
          = image_tag "icons/arrow_down.png", class: "section-down disabled-arrow", alt: _("Move Down")
