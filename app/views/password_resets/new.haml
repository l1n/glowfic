= form_tag password_resets_path, method: :post do
  .form-table#password-reset
    .editor-title= _("Request Password Reset")
    %div
      .sub= label_tag :username
      .even= text_field_tag :username, params[:username], placeholder: _("Username"), id: 'user_username', autocomplete: 'username'
    %div
      .sub= label_tag :email
      .odd= text_field_tag :email, params[:email], placeholder: _("Email address"), id: 'user_email', autocomplete: 'email'
    .form-table-ender= submit_tag _("Reset Password"), class: 'button'
