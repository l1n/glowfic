- content_for :breadcrumbs do
  = link_to _("You"), user_path(current_user)
  &raquo;
  = link_to _("Your Characters"), user_characters_path(current_user)
  &raquo;
  %b= _("Create New")
= form_for @character, url: characters_path, method: :post do |f|
  = f.hidden_field :default_icon_id
  .character-form
    .form-table#character-editor
      .editor-title= _("New Character")
      = render 'editor', f: f

  = render 'icon_selector'
