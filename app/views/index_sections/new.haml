- content_for :breadcrumbs do
  = link_to _("Indexes"), indexes_path
  &raquo;
  = link_to @section.index.name, @section.index
  &raquo;
  %b= _("New Section")


= form_for @section, url: index_sections_path, method: :post do |f|
  .form-table#index-section-editor
    .editor-title= format(_("Create %{name} Section"), name: @index.try(:name))
    = render 'editor', f: f
