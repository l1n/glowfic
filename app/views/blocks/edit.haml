- content_for :breadcrumbs do
  = link_to _("Blocks"), blocks_path
  &raquo;
  = format(_("Block on %{username}"), username: @block.blocked_user.username)
  &raquo;
  %b= _("Edit")

= form_for @block, url: block_path(@block), method: :put do |f|
  .form-table
    .editor-title= _("Edit Block")
    = render 'editor', f: f, blocked_user: @block.blocked_user
