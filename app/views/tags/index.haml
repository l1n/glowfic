- col_count = 4
- col_count += 1 unless @view.present?
- col_count += 1 if @view == 'Setting'

- if @view.present?
  - content_for :breadcrumbs do
    = link_to _("Tags"), tags_path
    &raquo;
    %b= tag_type_plural(@view)

%table
  %thead
    %tr
      %th.table-title{colspan: col_count}
        = @view.present? ? @view.titlecase.pluralize : 'Tags'
    %tr
      %th.subber.padding-10{colspan: col_count}
        = form_tag tags_path, method: :get do
          = _("Search for a tag:")
          = text_field_tag :name, params[:name], id: 'tag-search-name', placeholder: _("Name (case-insensitive)")
          = select_tag :view, options_for_select(@tag_options, @view), include_blank: _("— Choose Type —"), id: 'tag-view'
          = submit_tag _("Search"), class: 'button', id: 'tag-search'
    %tr
      %th.sub= _("Name")
      - unless @view.present?
        %th.sub= _("Type")
      - if @view == 'Setting'
        %th.sub= _("Owner")
      %th.sub= _("Posts")
      %th.sub= _("Characters")
      %th.sub
  %tbody
    - @tags.each do |tag|
      - klass = cycle('even', 'odd')
      %tr
        %td{class: klass}= localized_tag_link(tag)
        - unless @view.present?
          %td{class: klass}= link_to tag.type.titlecase, tags_path(view: tag.type)
        - if @view == 'Setting'
          %td{class: klass}
            = link_to tag.user do
              - if tag.owned?
                = tag.user.username
              - else
                %em= tag.user.deleted? ? 'deleted user' : tag.user.username
        %td{class: klass}= @post_counts.fetch(tag.id, 0)
        %td{class: klass}= tag.character_count
        %td.width-70.right-align{class: klass}
          - if tag.editable_by?(current_user)
            = link_to edit_tag_path(tag) do
              = image_tag "icons/pencil.png", alt: _("Edit")
          - if tag.deletable_by?(current_user)
            = link_to delete_path(tag), method: :delete, data: { confirm: format(_("Are you sure you want to delete %{tag}?"), tag: localized_tag_text(tag)) } do
              = image_tag "icons/cross.png", alt: _("Delete")
            &nbsp;
    - if @tags.empty?
      %tr
        %td.centered.padding-10{ class: cycle('even', 'odd'), colspan: col_count }= _("— No matching tags —")
  - if @tags.total_pages > 1
    %tfoot
      %tr
        %td{colspan: 6}= render 'posts/paginator', paginated: @tags
