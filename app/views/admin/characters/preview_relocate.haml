- content_for :breadcrumbs do
  = link_to _("Admin Tools"), admin_path
  &raquo;
  = link_to _("Character Relocate"), relocate_characters_path
  &raquo;
  = _("Preview")

= format(_("Transferring the following characters from %{username} to %{new_user_username}"), username: @characters.first.user.username, new_user_username: @new_user.username)
= render 'characters/icon_view', name: _("User characters"), characters: @characters, show_retired: true

= render 'relocate'
