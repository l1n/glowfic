= form_for @password_reset, url: password_reset_path(id: @password_reset.auth_token), method: :put do
  .form-table
    .editor-title= _("Change Password")
    %div
      .sub= label_tag :password, _("New")
      .odd= password_field_tag :password, params[:password], placeholder: _("New Password")
    %div
      .sub= label_tag :password_confirmation, _("Confirm")
      .even= password_field_tag :password_confirmation, params[:password_confirmation], placeholder: _("Confirm Password")
    .form-table-ender= submit_tag _("Save"), class: 'button'
