-# locals: ( f: )

%div
  .sub= f.label :name
  .even= f.text_field :name, placeholder: _("Index Name")
%div
  .sub= _("Owner")
  .odd= @index.user.deleted? ? '(deleted user)' : @index.user.username
%div
  .sub= f.label :privacy
  .even
    = f.select :privacy, options_from_collection_for_select(index_privacy_settings.to_a, :second, :first, @index.privacy)
%div
  .sub.vtop= _("Editors")
  .odd.radio-fields
    = f.radio_button :authors_locked, true, class: 'checkbox'
    = f.label :authors_locked, _("Just me"), value: true
    = f.radio_button :authors_locked, false, class: 'checkbox'
    = f.label :authors_locked, _("Any Constellation user"), value: false
%div
  .sub.vtop= f.label :description
  .even= f.text_area :description
.form-table-ender= submit_tag _("Save"), class: 'button'
