-# locals: ( f: )

%div
  .sub= f.label :name
  %div{class: cycle('even', 'odd')}= f.text_field :name, placeholder: _("Character Name")
%div
  .sub= f.label :nickname
  %div{class: cycle('even', 'odd')}= f.text_field :nickname, placeholder: _("Template Nickname")
%div
  .sub= f.label :screenname
  %div{class: cycle('even', 'odd')}= f.text_field :screenname, placeholder: _("Screen Name")
%div
  .sub= f.label :setting_ids, _("Setting")
  .select2-field{class: cycle('even', 'odd')}= tag_select(@character, f, :settings)
%div
  - klass = cycle('even', 'odd')
  .sub.vtop= f.label :template_id
  #template-choice{class: klass}
    = f.collection_select :template_id, @templates, :id, :name, { include_blank: _("— Choose Template —") },
      { class: 'chosen-select', disabled: params[:new_template].present? }
    - if @character.user == current_user
      .checkbox-field
        = check_box_tag :new_template, '1', params[:new_template].present?
        = label_tag :new_template, _("Create New Template")
- if @character.user == current_user
  #create_template{class: ('hidden' unless params[:new_template])}
    = f.fields_for :template do |ff|
      .sub= ff.label :name, _("↳ Name")
      %div{class: klass}
        = ff.hidden_field :id
        = ff.text_field :name, placeholder: _("Template Name")
%div
  .sub= f.label :cluster
  %div{class: cycle('even', 'odd')}= f.text_field :cluster, placeholder: _("Template Cluster Name")
- if @character.user.galleries.present?
  %div
    .sub= f.label :ungrouped_gallery_ids, _("Galleries")
    .select2-field{class: cycle('even', 'odd')}
      = f.collection_select(:ungrouped_gallery_ids,
      @character.user.galleries.ordered_by_name,
      :id, :name, { selected: @character.ungrouped_gallery_ids }, { multiple: true })
  %div
    .sub= f.label :gallery_group_ids, _("Gallery Groups")
    .select2-field{class: cycle('even', 'odd')}= tag_select(@character, f, :gallery_groups)
%div
  .sub= f.label :pb, _("Facecast")
  %div{class: cycle('even', 'odd')}= f.text_field :pb, placeholder: _("Facecast")
%div
  .sub.vtop= f.label :description
  %div{class: cycle('even', 'odd')}= f.text_area :description, placeholder: _("Description"), cols: 35
%div
  .sub= f.label :npc, _("NPC?")
  .checkbox-field{class: cycle('even', 'odd')}
    = f.check_box :npc
    = f.label :npc, _("Remove from character page and show in separate dropdown when writing")
%div
  .sub= f.label :retired, _("Retired?")
  .checkbox-field{class: cycle('even', 'odd')}
    = f.check_box :retired
    = f.label :retired, _("Do not display in character selector")
- if current_user.id != @character.user_id
  %div
    .sub.vtop= f.label :audit_comment, _("Moderator Note")
    %div{class: cycle('even', 'odd')}= f.text_area :audit_comment, placeholder: _("Explain reason for moderation here"), cols: 35
.form-table-ender= submit_tag _("Save"), class: 'button'
