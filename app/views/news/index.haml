.content-header
  = _("Site News")
  - if current_user&.has_permission?(:create_news)
    = link_to new_news_path do
      .link-box.action-new= _("+ New News Post")
= render @news

- if @news.total_entries > @news.per_page
  .paginator.centered.sub
    .pagination
      - args = { container: false, first_label: "&laquo; #{_('Newest')}", last_label: "#{_('Oldest')} &raquo;", previous_label: "&lt; #{_('Newer')}", next_label: "#{_('Older')} &gt;", summary_label: _("%d of %d") }
      .normal-pagination
        = will_paginate @news, args
      .mobile-pagination
        = will_paginate @news, args.merge(mobile_view: true)
  .clear
