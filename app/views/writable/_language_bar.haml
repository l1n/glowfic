-# locals: ( extra_class: nil )

#editor-language-bar{class: ['hidden', extra_class].compact}
  %label{for: 'editor-language'}= _("Language:")
  -# Options are filled in from gon by setupLanguageBar, so the list lives in one place.
  %select#editor-language
  %button.button#editor-language-wrap{type: 'button', title: 'Wrap the selected text in a span with this language'}= _("Wrap selection")
  .details
    = _("Marks a passage as being in another language, so screen readers pronounce it correctly and browsers hyphenate it properly.")
    = _("The Rich Text editor has the same thing in its toolbar.")
