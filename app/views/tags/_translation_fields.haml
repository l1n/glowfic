-# locals: ( tf:, describable: false )

.tag-translation
  %div
    .sub= tf.label :locale, _("Language")
    .tag-translation-field
      = tf.select :locale, Glowfic::Locales.content_options, { include_blank: _("— Choose Language —") }, { class: 'tag-translation-locale' }
  %div
    .sub= tf.label :name, _("Name")
    .tag-translation-field
      = tf.text_field :name, placeholder: _("Tag Name"), lang: tf.object.locale, dir: (tf.object.rtl? ? 'rtl' : nil)
  - if describable
    %div
      .sub.vtop= tf.label :description, _("Description")
      .tag-translation-field
        = tf.text_area :description, placeholder: _("Description"), cols: 35, lang: tf.object.locale, dir: (tf.object.rtl? ? 'rtl' : nil)
  %div
    .sub &nbsp;
    .checkbox-field.tag-translation-field
      = tf.check_box :_destroy, class: 'tag-translation-destroy'
      = tf.label :_destroy, _("Remove this translation when saving")
