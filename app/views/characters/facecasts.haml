%table
  %thead
    %tr
      %th.table-title{colspan: 4}= _("Facecasts")
    %tr
      %th.sub= link_to _("Facecast"), url_for(sort: nil)
      %th.sub= _("Type")
      %th.sub= link_to _("Name"), url_for(sort: 'name')
      %th.sub= link_to _("Writer"), url_for(sort: 'writer')
  %tbody
    - @pbs.each do |obj|
      %tr
        - klass = cycle('even', 'odd')
        %td.padding-5{class: klass}= obj.pb
        %td.padding-5{class: klass}= obj.type
        %td.padding-5{class: klass}
          - if obj.type == Character
            = link_to obj.name, character_path(obj.id)
          - else
            = link_to obj.name, template_path(obj.id)
        %td.padding-5{class: klass}= user_mem_link(obj.user_id, obj.username, false)
