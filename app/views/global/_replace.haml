-# locals: ( obj:, name:, icon:, alt_icon: )

.form-table#replace-form
  .editor-title= format(_("Replace All Uses of %{class}"), class: obj.class)
  = content_for :disclaimer
  %div
    .sub= _("Current")
    .sub= _("New")
  %div
    .replace-icon
      = icon_tag icon
      = name
      = content_for :aliases
    .replace-icon
      - if alt_icon
        = icon_tag alt_icon, id: 'new_icon'
      - else
        = no_icon_tag id: 'new_icon'
      = content_for :options
  - if @posts.present?
    .sub.colspan= _("Optional: Select Post(s)")
    .odd.centered.colspan
      .details= _("*If none are selected, replaces all uses*")
  - @posts.each do |post|
    .replace-posts.checkbox-field{class: cycle('even', 'odd')}
      = check_box_tag :'post_ids[]', post.id, false, id: nil
      = link_to post.subject, post_path(post)
  .form-table-ender= submit_tag _("Replace"), class: 'button'
