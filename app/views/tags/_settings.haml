-# locals: ()

%table.tag-right-content-box
  %thead
    %tr
      %th.table-title{colspan: 6}= safe_format(_("Settings Tagged: %{tag}"), tag: localized_tag_name(@tag))
  %tbody
    - @tag.child_settings.each do |setting|
      %tr
        %td{class: cycle('even', 'odd')}= localized_tag_link(setting)
